  },
  {
    "name": "idx-numeric-key-on-object",
    "comment": "CORE §5.2.3: a decimal-digit segment against an OBJECT is a member key, not an index",
    "doc": {
      "0": "x"
    },
    "patch": [
      {
        "op": "replace",
        "path": "/0",
        "value": "y"
      }
    ],
    "expected": {
      "0": "y"
    }
  },
  {
    "name": "idx-add-index-0-empty-array",
