[
  {
    "name": "idx-add-at-length-appends",
    "comment": "CORE §5.3.1: add index == length appends",
    "doc": [
      1,
      2
    ],
    "patch": [
      {
        "op": "add",
        "path": "/2",
        "value": 3
      }
    ],
    "expected": [
      1,
      2,
      3
    ]
  },
  {
    "name": "idx-add-beyond-length",
    "comment": "CORE §5.3.1: add index > length -> INDEX_OUT_OF_BOUNDS",
    "doc": [
      1
    ],
    "patch": [
      {
        "op": "add",
        "path": "/5",
        "value": 9
      }
    ],
    "error": {
      "code": "INDEX_OUT_OF_BOUNDS",
      "index": 0
    }
  },
  {
    "name": "idx-replace-at-length",
    "comment": "CORE §5.3.1: replace requires index < length",
    "doc": [
      1,
      2
    ],
    "patch": [
      {
        "op": "replace",
        "path": "/2",
        "value": 9
      }
    ],
    "error": {
      "code": "INDEX_OUT_OF_BOUNDS",
      "index": 0
    }
  },
  {
    "name": "idx-remove-at-length",
    "comment": "CORE §5.3.1: remove requires index < length",
    "doc": [
      1,
      2
    ],
