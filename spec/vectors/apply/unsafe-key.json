[
  {
    "name": "uk-proto-final",
    "comment": "§8.6.1: __proto__ as the final write-side segment -> UNSAFE_KEY",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "add",
        "path": "/__proto__",
        "value": 1
      }
    ],
    "error": {
      "code": "UNSAFE_KEY",
      "index": 0
    }
  },
  {
    "name": "uk-proto-intermediate",
    "comment": "§8.6.1: __proto__ anywhere on the write-side path -> UNSAFE_KEY",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "add",
        "path": "/__proto__/x",
        "value": 1
      }
    ],
    "error": {
      "code": "UNSAFE_KEY",
      "index": 0
    }
  },
  {
    "name": "uk-proto-deep",
    "comment": "§8.6.1: a nested __proto__ segment is still guarded",
    "doc": {
      "a": {
        "b": 1
      }
    },
    "patch": [
      {
        "op": "replace",
        "path": "/a/__proto__",
        "value": 1
      }
    ],
    "error": {
      "code": "UNSAFE_KEY",
      "index": 0
    }
  },
  {
    "name": "uk-constructor-prototype",
    "comment": "§8.6.1: 'prototype' preceded by an existing 'constructor' -> UNSAFE_KEY",
    "doc": {
      "constructor": {}
    },
    "patch": [
      {
        "op": "add",
        "path": "/constructor/prototype",
        "value": 1
      }
    ],
    "error": {
      "code": "UNSAFE_KEY",
      "index": 0
    }
  },
  {
    "name": "uk-constructor-prototype-intermediate",
    "comment": "§8.6.1: constructor/prototype guarded as an intermediate too (fires before existence, §8.3.5)",
    "doc": {
      "constructor": {}
    },
    "patch": [
      {
        "op": "add",
        "path": "/constructor/prototype/x",
        "value": 1
      }
    ],
    "error": {
      "code": "UNSAFE_KEY",
      "index": 0
    }
  },
  {
    "name": "uk-move-dest-proto",
    "comment": "§8.6.1: a move DESTINATION of __proto__ is a write-side segment -> UNSAFE_KEY",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "move",
        "from": "/a",
        "path": "/__proto__"
      }
    ],
    "error": {
      "code": "UNSAFE_KEY",
      "index": 0
    }
  },
  {
    "name": "uk-allowed-standalone-constructor",
    "comment": "§8.6.1: standalone 'constructor' is a legitimate key and MUST remain usable",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "add",
        "path": "/constructor",
        "value": 5
      }
    ],
    "expected": {
      "a": 1,
      "constructor": 5
    }
  },
  {
    "name": "uk-allowed-standalone-prototype",
    "comment": "§8.6.1: 'prototype' NOT preceded by 'constructor' is a legitimate key",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "add",
        "path": "/prototype",
        "value": 5
      }
    ],
    "expected": {
      "a": 1,
      "prototype": 5
    }
  },
  {
    "name": "uk-allowed-prototype-under-non-constructor",
    "comment": "§8.6.1: 'prototype' under a non-constructor parent is usable",
    "doc": {
      "a": {}
    },
    "patch": [
      {
        "op": "add",
        "path": "/a/prototype",
        "value": 5
      }
    ],
    "expected": {
      "a": {
        "prototype": 5
      }
    }
  },
  {
    "name": "uk-readside-proto-unresolvable",
    "comment": "§8.6.1: read-side (test) __proto__ resolves by own-property -> PATH_UNRESOLVABLE, never UNSAFE_KEY",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "test",
        "path": "/__proto__",
        "value": {}
      }
    ],
    "error": {
      "code": "PATH_UNRESOLVABLE",
      "index": 0
    }
  },
  {
    "name": "uk-readside-move-source-proto",
    "comment": "§8.6.1: a move SOURCE of __proto__ is read-side -> PATH_UNRESOLVABLE",
    "doc": {
      "a": 1
    },
    "patch": [
      {
        "op": "move",
        "from": "/__proto__",
        "path": "/b"
      }
    ],
    "error": {
      "code": "PATH_UNRESOLVABLE",
      "index": 0
    }
  }
]
