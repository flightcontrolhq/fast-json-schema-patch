[
  {
    "name": "a1-add-object-member",
    "comment": "RFC 6902 A.1: add an object member (§8.3)",
    "doc": {
      "foo": "bar"
    },
    "patch": [
      {
        "op": "add",
        "path": "/baz",
        "value": "qux"
      }
    ],
    "expected": {
      "foo": "bar",
      "baz": "qux"
    }
  },
  {
    "name": "a2-add-array-element",
    "comment": "RFC 6902 A.2: insert into an array, shifting (§8.3)",
    "doc": {
      "foo": [
        "bar",
        "baz"
      ]
    },
    "patch": [
      {
        "op": "add",
        "path": "/foo/1",
        "value": "qux"
      }
    ],
    "expected": {
      "foo": [
        "bar",
        "qux",
        "baz"
      ]
    }
  },
  {
    "name": "a3-remove-object-member",
    "comment": "RFC 6902 A.3: remove an object member",
    "doc": {
      "baz": "qux",
      "foo": "bar"
    },
    "patch": [
      {
        "op": "remove",
        "path": "/baz"
      }
    ],
    "expected": {
      "foo": "bar"
    }
  },
  {
    "name": "a4-remove-array-element",
    "comment": "RFC 6902 A.4: splice out an array element",
    "doc": {
      "foo": [
        "bar",
        "qux",
        "baz"
      ]
    },
    "patch": [
      {
        "op": "remove",
        "path": "/foo/1"
      }
    ],
    "expected": {
      "foo": [
        "bar",
        "baz"
      ]
    }
  },
  {
    "name": "a5-replace-value",
    "comment": "RFC 6902 A.5: replace an existing member value",
    "doc": {
      "baz": "qux",
      "foo": "bar"
    },
    "patch": [
      {
        "op": "replace",
        "path": "/baz",
        "value": "boo"
      }
    ],
    "expected": {
      "baz": "boo",
      "foo": "bar"
    }
  },
  {
    "name": "a6-move-value",
    "comment": "RFC 6902 A.6: move a value between objects (§8.3)",
    "doc": {
      "foo": {
        "bar": "baz",
        "waldo": "fred"
      },
      "qux": {
        "corge": "grault"
      }
    },
    "patch": [
      {
        "op": "move",
        "from": "/foo/waldo",
        "path": "/qux/thud"
      }
    ],
    "expected": {
      "foo": {
        "bar": "baz"
      },
      "qux": {
        "corge": "grault",
        "thud": "fred"
      }
    }
  },
  {
    "name": "a7-move-array-element",
    "comment": "RFC 6902 A.7: move an array element (remove then add)",
    "doc": {
      "foo": [
        "all",
        "grass",
        "cows",
        "eat"
      ]
    },
    "patch": [
      {
        "op": "move",
        "from": "/foo/1",
        "path": "/foo/3"
      }
    ],
    "expected": {
      "foo": [
        "all",
        "cows",
        "eat",
        "grass"
      ]
    }
  },
  {
    "name": "a8-test-success",
    "comment": "RFC 6902 A.8: test ops that succeed leave the document unchanged",
    "doc": {
      "baz": "qux",
      "foo": [
        "a",
        2,
        "c"
      ]
    },
    "patch": [
      {
        "op": "test",
        "path": "/baz",
        "value": "qux"
      },
      {
        "op": "test",
        "path": "/foo/1",
        "value": 2
      }
    ],
    "expected": {
      "baz": "qux",
      "foo": [
        "a",
        2,
        "c"
      ]
    }
  },
  {
    "name": "a9-test-failure",
    "comment": "RFC 6902 A.9: a failing test throws TEST_FAILED",
    "doc": {
      "baz": "qux"
    },
    "patch": [
      {
        "op": "test",
        "path": "/baz",
        "value": "bar"
      }
    ],
    "error": {
      "code": "TEST_FAILED",
      "index": 0
    }
  },
  {
    "name": "a10-add-nested-member",
    "comment": "RFC 6902 A.10: add a nested object member value",
    "doc": {
      "foo": "bar"
    },
    "patch": [
      {
        "op": "add",
        "path": "/child",
        "value": {
          "grandchild": {}
        }
      }
    ],
    "expected": {
      "foo": "bar",
      "child": {
        "grandchild": {}
      }
    }
  },
  {
    "name": "a11-ignore-unrecognized-fields",
    "comment": "RFC 6902 A.11: unrecognized op fields are ignored",
    "doc": {
      "foo": "bar"
    },
    "patch": [
      {
        "op": "add",
        "path": "/baz",
        "value": "qux",
        "xyz": 123
      }
    ],
    "expected": {
      "foo": "bar",
      "baz": "qux"
    }
  },
  {
    "name": "a12-add-to-nonexistent-target",
    "comment": "RFC 6902 A.12: add through a missing intermediate -> PATH_UNRESOLVABLE (§8.2.2)",
    "doc": {
      "foo": "bar"
    },
    "patch": [
      {
        "op": "add",
        "path": "/baz/bat",
        "value": "qux"
      }
    ],
    "error": {
      "code": "PATH_UNRESOLVABLE",
      "index": 0
    }
  },
  {
    "name": "a14-escape-ordering",
    "comment": "RFC 6902 A.14: '/~01' decodes ~1->/ then ~0->~ = key '~1' (§3.3)",
    "doc": {
      "/": 9,
      "~1": 10
    },
    "patch": [
      {
        "op": "test",
        "path": "/~01",
        "value": 10
      }
    ],
    "expected": {
      "/": 9,
      "~1": 10
    }
  },
  {
    "name": "a15-compare-string-vs-number",
    "comment": "RFC 6902 A.15: 10 != \"10\"; test with no coercion fails (§2.4.3)",
    "doc": {
      "/": 9,
      "~1": 10
    },
    "patch": [
      {
        "op": "test",
        "path": "/~01",
        "value": "10"
      }
    ],
    "error": {
      "code": "TEST_FAILED",
      "index": 0
    }
  },
  {
    "name": "a16-add-array-value-at-dash",
    "comment": "RFC 6902 A.16: add an array VALUE at /- appends the whole value (§3.5)",
    "doc": {
      "foo": [
        "bar"
      ]
    },
    "patch": [
      {
        "op": "add",
        "path": "/foo/-",
        "value": [
          "abc",
          "def"
        ]
      }
    ],
    "expected": {
      "foo": [
        "bar",
        [
          "abc",
          "def"
        ]
      ]
    }
  }
]
