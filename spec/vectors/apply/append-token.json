[
  {
    "name": "dash-add-nested-array",
    "comment": "CORE §2.5: add at /- appends to a nested array",
    "doc": {
      "a": [
        1
      ]
    },
    "patch": [
      {
        "op": "add",
        "path": "/a/-",
        "value": 2
      }
    ],
    "expected": {
      "a": [
        1,
        2
      ]
    }
  },
  {
    "name": "dash-add-root-array",
    "comment": "CORE §2.5/CORE §4.2.1: add at /- appends at the array root",
    "doc": [
      1
    ],
    "patch": [
      {
        "op": "add",
        "path": "/-",
        "value": 2
      }
    ],
    "expected": [
      1,
      2
    ]
  },
  {
    "name": "dash-add-into-empty-array",
    "comment": "CORE §2.5: /- on an empty array lands at index 0",
    "doc": {
      "a": []
    },
    "patch": [
      {
        "op": "add",
        "path": "/a/-",
        "value": 9
      }
    ],
    "expected": {
      "a": [
        9
      ]
    }
  },
  {
    "name": "dash-remove-invalid-pointer",
