      }
    ],
    "error": {
      "code": "INVALID_POINTER",
      "index": 0
    }
  },
  {
    "name": "dash-test-read-side-unresolvable",
    "comment": "CORE §2.5/CORE §5.3.1: '-' final on test (read-side) fails own-index resolution -> PATH_UNRESOLVABLE",
