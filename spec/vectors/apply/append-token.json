    }
  },
  {
    "name": "dash-copy-dest-appends",
    "comment": "CORE §2.5/CORE §5.3: '-' as a copy DESTINATION appends a clone",
    "doc": {
      "a": [
        1
      ],
      "b": 2
    },
    "patch": [
