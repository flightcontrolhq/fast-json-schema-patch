  {
    "name": "plan-primaryKey-id",
    "comment": "CORE §3.5.3: default candidate 'id' selected; requiredFields/hashFields populated",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "expectedPlan": [
      {
        "path": "/users",
        "primaryKey": "id",
        "strategy": "primaryKey",
        "requiredFields": [
          "id"
        ],
        "hashFields": [
          "id"
        ]
      }
    ]
  },
