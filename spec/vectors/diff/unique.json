        "b"
      ]
    },
    "modified": {
      "tags": [
        "a",
        "b",
        "c"
      ]
    },
    "expectedPatch": [
      {
        "op": "add",
        "path": "/tags/2",
        "value": "c"
      }
    ]
  },
