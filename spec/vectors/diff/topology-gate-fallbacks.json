[
  {
    "name": "gate-set-duplicate-in-original-falls-back-lcs",
    "comment": "CORE §8.5.1: a deep-equal duplicate in `original` fails the set gate → the array falls back to sequence/LCS (exact reconstruction)",
    "schema": {
      "type": "object",
      "properties": {
        "xs": {
          "type": "array",
          "x-schema-patch-topology": "set",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "original": {
      "xs": [
        1,
        2,
        2,
        3
      ]
    },
    "modified": {
      "xs": [
        1,
        2,
        3
      ]
    },
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/xs/2",
        "oldValue": 2
      }
    ]
  },
