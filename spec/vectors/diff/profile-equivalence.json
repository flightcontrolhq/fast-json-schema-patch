  {
    "name": "equiv-default-object-vs-declared-granular-compat",
    "comment": "CORE §8.8.1: the default object granularity IS `granular`; declaring it explicitly changes nothing (member-wise ops) [spec-v1 compat schema]",
    "schema": {
      "type": "object",
      "properties": {
        "cfg": {
          "type": "object",
          "properties": {
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            }
          }
        }
      }
    },
    "original": {
      "cfg": {
        "a": 1,
        "b": 2
      }
    },
    "modified": {
      "cfg": {
        "a": 1,
        "b": 3
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/cfg/b",
        "value": 3,
        "oldValue": 2
      }
    ]
  },
  {
    "name": "equiv-default-object-vs-declared-granular-declared",
    "comment": "CORE §8.8.1: the default object granularity IS `granular`; declaring it explicitly changes nothing (member-wise ops) [declared-topology schema — byte-identical output]",
