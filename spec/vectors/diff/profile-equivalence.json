[
  {
    "name": "equiv-autodetect-id-vs-map-single-key-compat",
    "comment": "CORE §8.8.1: an auto-detected primaryKey `id` IS map/insignificant keys=[id] — reorder+modify+add produce identical keyed ops [spec-v1 compat schema]",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "b",
          "name": "B"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "b",
          "name": "B2"
        },
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "c",
          "name": "C"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/users/1/name",
        "value": "B2",
        "oldValue": "B"
      },
      {
        "op": "add",
        "path": "/users/-",
        "value": {
          "id": "c",
          "name": "C"
        }
      }
    ]
  },
  {
    "name": "equiv-autodetect-id-vs-map-single-key-declared",
    "comment": "CORE §8.8.1: an auto-detected primaryKey `id` IS map/insignificant keys=[id] — reorder+modify+add produce identical keyed ops [declared-topology schema — byte-identical output]",
