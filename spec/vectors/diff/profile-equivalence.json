        },
        {
          "id": "b",
          "name": "B"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "b",
          "name": "B2"
        },
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "c",
          "name": "C"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/users/1/name",
        "value": "B2",
        "oldValue": "B"
      },
      {
        "op": "add",
        "path": "/users/-",
        "value": {
          "id": "c",
          "name": "C"
        }
      }
    ]
  },
  {
    "name": "equiv-primarykeymap-vs-map-declared-compat",
    "comment": "CORE §8.8.1/§3.4.3: a primaryKeyMap {/rows: name} override IS map/insignificant keys=[name] — identical output [spec-v1 compat schema]",
    "schema": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "v": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "primaryKeyMap": {
        "/rows": "name"
      }
    },
    "original": {
      "rows": [
        {
          "name": "x",
          "v": 1
        },
        {
          "name": "y",
          "v": 2
        }
      ]
    },
    "modified": {
      "rows": [
        {
          "name": "y",
          "v": 9
        },
        {
          "name": "x",
          "v": 1
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/rows/1/v",
        "value": 9,
        "oldValue": 2
      }
    ]
  },
