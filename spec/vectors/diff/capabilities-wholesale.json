  {
    "name": "wrf-nested-inner-triggers-outer-keeps",
    "comment": "§5.9.1 bottom-up: the inner array crosses its own threshold and goes wholesale while the outer array keeps granular descent",
    "schema": {
      "type": "object",
      "properties": {
        "outer": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "inner": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "includeOldValue": false,
        "wholesaleReplaceFallback": true
      }
    },
    "original": {
      "outer": [
        {
          "id": "g",
          "inner": [
            "AAAAAAAAAAA",
            "u1ccccccccc",
            "u2cccccccc"
          ]
        },
        {
          "id": "h",
          "inner": [
            "z"
          ]
        }
      ]
    },
    "modified": {
      "outer": [
        {
          "id": "g",
          "inner": [
            "BBBBBBBBBBB",
            "u1ccccccccc",
            "u2cccccccc"
          ]
        },
        {
          "id": "h",
          "inner": [
            "z"
          ]
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/outer/0/inner",
        "value": [
          "BBBBBBBBBBB",
          "u1ccccccccc",
          "u2cccccccc"
        ]
      }
    ]
  }
