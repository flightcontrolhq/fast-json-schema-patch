  {
    "name": "wrf-off-default-is-granular",
    "comment": "§5.9: with the capability OFF, the same rewrite stays a granular op stream (byte-stability baseline)",
    "schema": {
      "type": "object",
      "properties": {
        "a": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
