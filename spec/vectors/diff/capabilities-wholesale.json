[
  {
    "name": "wrf-estimate-equals-threshold-keeps-granular",
    "comment": "§5.9.3: estimate(43) == threshold(43); strict > false, so the granular replace is KEPT",
    "schema": {
      "type": "object",
      "properties": {
        "a": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "includeOldValue": false,
        "wholesaleReplaceFallback": true
      }
    },
    "original": {
      "a": [
        "AAAAAAAAAAA",
        "u1ccccccccc",
        "u2ccccccccc"
      ]
    },
    "modified": {
      "a": [
        "BBBBBBBBBBB",
        "u1ccccccccc",
        "u2ccccccccc"
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/a/0",
        "value": "BBBBBBBBBBB"
      }
    ]
  },
  {
    "name": "wrf-estimate-exceeds-by-one-goes-wholesale",
    "comment": "§5.9.3: same shape, one unchanged element 1 byte shorter -> threshold(42) < estimate(43) -> WHOLESALE replace of /a",
    "schema": {
      "type": "object",
      "properties": {
        "a": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "includeOldValue": false,
        "wholesaleReplaceFallback": true
      }
    },
    "original": {
      "a": [
        "AAAAAAAAAAA",
        "u1ccccccccc",
        "u2cccccccc"
      ]
    },
    "modified": {
      "a": [
        "BBBBBBBBBBB",
        "u1ccccccccc",
        "u2cccccccc"
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/a",
        "value": [
          "BBBBBBBBBBB",
          "u1ccccccccc",
          "u2cccccccc"
        ]
      }
    ]
  },
  {
