                "type": "string"
              },
              "d": {
                "type": "string"
              },
              "s": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "original": {
      "a": [
        {
          "t": "T0",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 0
        },
        {
          "t": "T1",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 1
        },
        {
          "t": "T2",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 2
        },
        {
          "t": "T3",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 3
