      ]
    },
    "modified": {
      "a": [
        {
          "t": "Q9",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 100
        },
        {
          "t": "Q10",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 101
        },
        {
          "t": "Q11",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 102
        },
        {
          "t": "Q12",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 103
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/a/0",
        "oldValue": {
          "t": "T0",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 0
        }
      },
      {
        "op": "remove",
        "path": "/a/0",
        "oldValue": {
          "t": "T1",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 1
        }
      },
      {
        "op": "remove",
        "path": "/a/0",
        "oldValue": {
          "t": "T2",
          "d": "xxxxxxxxxxxxxxxxxxxx",
          "s": 2
        }
      },
      {
        "op": "replace",
        "path": "/a/0/t",
        "value": "Q9",
        "oldValue": "T3"
      },
