[
  {
    "name": "ptr-slash-key-replace",
    "comment": "CORE §2.2: object key containing '/' escapes to ~1 in the pointer",
    "original": {
      "a/b": 1
    },
    "modified": {
      "a/b": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/a~1b",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-tilde-key-replace",
    "comment": "CORE §2.2: object key containing '~' escapes to ~0",
    "original": {
      "a~b": 1
    },
    "modified": {
      "a~b": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/a~0b",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-tilde1-lookalike-key",
    "comment": "CORE §2.2: key literally 'a~1b' escapes ~ FIRST then / -> 'a~01b' (order matters)",
    "original": {
      "a~1b": 1
    },
    "modified": {
      "a~1b": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/a~01b",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-empty-string-key",
    "comment": "CORE §2.2: the empty string is a valid key; pointer '/' addresses member ''",
    "original": {
      "": 1
    },
    "modified": {
      "": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-nested-slash-key",
    "comment": "CORE §2.2: escaping applies at each segment; /x/a~1b",
    "original": {
      "x": {
        "a/b": 1
      }
    },
    "modified": {
      "x": {
        "a/b": 9
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/x/a~1b",
        "value": 9,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-add-slash-key",
    "comment": "CORE §2.2/GEN §2.3: add op path escapes the new key",
    "original": {},
    "modified": {
      "c/d": 5
    },
    "expectedPatch": [
      {
        "op": "add",
        "path": "/c~1d",
        "value": 5
      }
    ]
  },
  {
    "name": "ptr-remove-tilde-key",
    "comment": "CORE §2.2/GEN §2.3: remove op path escapes the removed key",
    "original": {
      "e~f": 7
    },
    "modified": {},
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/e~0f",
        "oldValue": 7
      }
    ]
  },
  {
    "name": "ptr-both-escapes-key",
    "comment": "CORE §2.2: '~/' escapes to '~0~1' (~ before /)",
    "original": {
      "~/": 1
    },
    "modified": {
      "~/": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/~0~1",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-unicode-key",
    "comment": "CORE §2.2: non-ASCII keys pass through unescaped (only ~ and / are escaped)",
    "original": {
      "café": 1
    },
    "modified": {
      "café": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/café",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-emoji-key",
    "comment": "CORE §2.2: astral-plane key passes through unescaped",
    "original": {
      "🔑": 1
    },
    "modified": {
      "🔑": 2
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/🔑",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-numeric-string-object-key",
    "comment": "CORE §5.2.3: a decimal-digit key on an OBJECT is an ordinary member key, not an index",
    "original": {
      "0": 1,
      "10": "x"
    },
    "modified": {
      "0": 9,
      "10": "x"
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/0",
        "value": 9,
        "oldValue": 1
      }
    ]
  },
  {
    "name": "ptr-slash-inside-array-item-object",
    "comment": "CORE §2.2: escaping still applies inside array-item object diffs",
    "original": [
      {
        "p/q": 1
      }
    ],
    "modified": [
      {
        "p/q": 2
      }
    ],
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/0/p~1q",
        "value": 2,
        "oldValue": 1
      }
    ]
  }
]
