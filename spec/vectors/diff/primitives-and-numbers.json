  {
    "name": "num-2pow53-distinct-replace",
    "comment": "CORE §1.2.2: 2^53 vs 2^53+2 are distinct f64 -> replace",
    "original": {
      "a": 9007199254740992
    },
    "modified": {
      "a": 9007199254740994
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/a",
        "value": 9007199254740994,
        "oldValue": 9007199254740992
      }
    ]
  },
  {
    "name": "num-large-int-replace",
