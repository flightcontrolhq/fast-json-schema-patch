  {
    "name": "gate-duplicate-in-original",
    "comment": "CONF §6.1(c): duplicate key within ORIGINAL -> LCS fallback",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "a",
          "name": "B"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "a",
          "name": "C"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/users/0",
        "oldValue": {
          "id": "a",
          "name": "A"
        }
      },
      {
        "op": "replace",
        "path": "/users/0/name",
        "value": "C",
        "oldValue": "B"
      }
    ]
  },
