  {
    "name": "gate-override-does-not-bypass",
    "comment": "GEN §4.3/CONF §6.1: a primaryKeyMap override does NOT bypass the gate; duplicate keys still fall back to LCS",
    "schema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "v": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "primaryKeyMap": {
        "/items": "id"
      }
    },
    "original": {
      "items": [
        {
          "id": "a",
          "v": 1
        },
        {
          "id": "a",
          "v": 2
        }
      ]
    },
    "modified": {
      "items": [
        {
          "id": "a",
          "v": 3
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/items/0",
        "oldValue": {
          "id": "a",
          "v": 1
        }
      },
      {
        "op": "replace",
        "path": "/items/0/v",
        "value": 3,
        "oldValue": 2
      }
    ]
  }
]
