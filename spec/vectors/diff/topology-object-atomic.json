[
  {
    "name": "object-atomic-member-change-whole-replace",
    "comment": "CORE §8.6.1: any member difference under an atomic object emits one whole-object replace at its path",
    "schema": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "x-schema-patch-granularity": "atomic",
          "properties": {
            "a": {
              "type": "number"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "v": {
                    "type": "number"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        }
      }
    },
    "original": {
      "config": {
        "a": 1,
        "rules": [
          {
            "id": "r1",
            "v": 1
          }
        ]
      }
    },
    "modified": {
      "config": {
        "a": 2,
        "rules": [
          {
            "id": "r1",
            "v": 1
          }
        ]
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/config",
        "value": {
          "a": 2,
          "rules": [
            {
              "id": "r1",
              "v": 1
            }
          ]
        },
        "oldValue": {
          "a": 1,
          "rules": [
            {
              "id": "r1",
              "v": 1
            }
          ]
        }
      }
    ]
  },
