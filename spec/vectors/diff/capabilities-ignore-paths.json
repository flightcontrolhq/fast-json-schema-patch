      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "v": {
                "type": "string"
              },
              "ts": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/items/*/ts"
        ]
