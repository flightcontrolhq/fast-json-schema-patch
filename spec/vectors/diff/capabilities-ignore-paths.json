              },
              "ts": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/items/*/ts"
        ]
      }
    },
    "original": {
      "items": [
        {
          "v": "a",
          "ts": 1
        },
        {
          "v": "b",
          "ts": 1
        }
      ]
    },
    "modified": {
      "items": [
        {
          "v": "a",
          "ts": 9
        },
        {
          "v": "b",
          "ts": 1
        }
      ]
    },
    "expectedPatch": []
  },
  {
    "name": "ip-lcs-real-and-ignored-mixed",
    "comment": "§5.10.5: a real field change descends granularly; ignored drift is dropped",
    "schema": {
