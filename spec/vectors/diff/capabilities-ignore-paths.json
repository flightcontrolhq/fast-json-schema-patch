  {
    "name": "ip-unique-coexists-with-unrelated-ignore",
    "comment": "§5.10: an unrelated ignore leaves a unique array's positional replaces intact",
    "schema": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "ts": {
              "type": "number"
            }
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/meta/ts"
        ]
      }
    },
    "original": {
      "tags": [
        "a",
        "b"
      ],
      "meta": {
        "ts": 1
      }
    },
    "modified": {
      "tags": [
        "a",
        "x"
      ],
      "meta": {
        "ts": 2
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/tags/1",
        "value": "x",
        "oldValue": "b"
      }
    ]
  },
  {
    "name": "ip-emitmoves-move-pairing-with-drift",
    "comment": "§5.10.5: under emitMoves, a relocated item whose ignored field drifted is ONE move, not remove+add",
    "schema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "v": {
                "type": "string"
              },
              "ts": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "emitMoves": true,
        "ignorePaths": [
          "/items/*/ts"
        ]
      }
    },
    "original": {
      "items": [
        {
          "v": "X",
          "ts": 1
        },
        {
          "v": "Y",
          "ts": 1
        }
      ]
    },
    "modified": {
      "items": [
        {
          "v": "Y",
          "ts": 9
        },
        {
          "v": "X",
          "ts": 1
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "move",
        "from": "/items/0",
        "path": "/items/1"
      }
    ]
  },
  {
    "name": "ip-wholesale-disabled-by-ignore-beneath",
    "comment": "§5.10.6: wholesaleReplaceFallback is DISABLED for an array with an ignore path beneath it (no leaked ignored content)",
    "schema": {
      "type": "object",
      "properties": {
        "a": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "string"
              },
              "ts": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "wholesaleReplaceFallback": true,
        "ignorePaths": [
          "/a/*/ts"
        ]
      }
    },
    "original": {
      "a": [
        {
          "t": "AAAAAAAAAA",
          "ts": 1
        },
        {
          "t": "BBBBBBBBBB",
          "ts": 2
        }
      ]
    },
    "modified": {
      "a": [
        {
          "t": "ZZZZZZZZZZ",
          "ts": 5
        },
        {
          "t": "YYYYYYYYYY",
          "ts": 6
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/a/0",
        "oldValue": {
          "t": "AAAAAAAAAA",
          "ts": 1
        }
      },
      {
        "op": "replace",
        "path": "/a/0/t",
        "value": "ZZZZZZZZZZ",
        "oldValue": "BBBBBBBBBB"
      },
      {
        "op": "add",
        "path": "/a/1",
        "value": {
          "t": "YYYYYYYYYY",
          "ts": 6
        }
      }
    ]
  }
]
