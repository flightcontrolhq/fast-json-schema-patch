[
  {
    "name": "ip-object-member-ignored-noop",
    "comment": "§5.10.4: an ignored object member changing alone yields NO ops",
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/meta/ts"
        ]
      }
    },
    "original": {
      "meta": {
        "ts": 1,
        "n": "a"
      }
    },
    "modified": {
      "meta": {
        "ts": 2,
        "n": "a"
      }
    },
    "expectedPatch": []
  },
  {
    "name": "ip-object-member-real-change-survives",
    "comment": "§5.10.4: a real sibling change survives while the ignored member is suppressed",
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/meta/ts"
        ]
      }
    },
    "original": {
      "meta": {
        "ts": 1,
        "n": "a"
      }
    },
    "modified": {
      "meta": {
        "ts": 2,
        "n": "b"
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/meta/n",
        "value": "b",
        "oldValue": "a"
      }
    ]
  },
  {
    "name": "ip-real-change-no-ignored-drift-exact",
    "comment": "§7.6: with the ignored field unchanged, reconstruction is exact",
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/meta/ts"
        ]
      }
    },
    "original": {
      "meta": {
        "ts": 1,
        "n": "a"
      }
    },
    "modified": {
      "meta": {
        "ts": 1,
        "n": "b"
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/meta/n",
        "value": "b",
        "oldValue": "a"
      }
    ]
  },
  {
    "name": "ip-wildcard-any-member-at-level",
    "comment": "§5.10.3: a `/*/ts` wildcard ignores `ts` under any top-level member",
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/*/ts"
        ]
      }
    },
    "original": {
      "a": {
        "ts": 1
      },
      "b": {
        "ts": 1,
        "k": 2
      }
    },
    "modified": {
      "a": {
        "ts": 9
      },
      "b": {
        "ts": 9,
        "k": 3
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/b/k",
        "value": 3,
        "oldValue": 2
      }
    ]
  },
  {
    "name": "ip-modified-only-ignored-member-not-added",
