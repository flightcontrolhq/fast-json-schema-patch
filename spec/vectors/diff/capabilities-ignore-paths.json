  {
    "name": "ip-pk-wildcard-under-keyed-items",
    "comment": "§5.10.3: `/users/*/updatedAt` ignores updatedAt in each keyed item",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "updatedAt": {
                "type": "number"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/users/*/updatedAt"
        ]
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A",
          "updatedAt": 1
        },
        {
          "id": "b",
          "name": "B",
          "updatedAt": 1
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "a",
          "name": "A",
          "updatedAt": 2
        },
        {
          "id": "b",
          "name": "B",
          "updatedAt": 1
        }
      ]
    },
    "expectedPatch": []
  },
  {
    "name": "ip-pk-real-field-survives-ignored-drift",
    "comment": "§5.10.3/§5.10.5: a keyed item's real field change survives while updatedAt drifts",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "updatedAt": {
                "type": "number"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "ignorePaths": [
          "/users/*/updatedAt"
        ]
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A",
          "updatedAt": 1
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "a",
          "name": "A2",
          "updatedAt": 2
        }
