[
  {
    "name": "em-lcs-relocation-primitive",
    "comment": "GEN §8.5: a relocated deep-equal element becomes a single move (front->back)",
    "options": {
      "capabilities": {
        "emitMoves": true
      }
    },
    "original": [
      1,
      2,
      3,
      4
    ],
    "modified": [
      2,
      3,
      4,
      1
    ],
    "expectedPatch": [
      {
        "op": "move",
        "from": "/0",
        "path": "/3"
      }
    ]
  },
  {
    "name": "em-lcs-relocation-object",
    "comment": "GEN §8.5: an object element relocated intact becomes a move (no value/oldValue)",
    "options": {
      "capabilities": {
        "emitMoves": true
      }
    },
    "original": [
      {
        "id": "x",
        "n": 1
      },
      {
        "id": "y",
        "n": 2
      },
      {
        "id": "z",
        "n": 3
      }
    ],
    "modified": [
      {
        "id": "y",
        "n": 2
      },
      {
        "id": "z",
        "n": 3
      },
      {
        "id": "x",
        "n": 1
      }
    ],
    "expectedPatch": [
      {
        "op": "move",
        "from": "/0",
        "path": "/2"
      }
    ]
  },
  {
    "name": "em-lcs-non-relocation-stays-replace",
    "comment": "GEN §8.5: a changed (non-identical) element is NOT a move; stays a replace",
    "options": {
      "capabilities": {
        "emitMoves": true
      }
    },
    "original": [
      1,
      2
    ],
    "modified": [
      1,
      9
    ],
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/1",
        "value": 9,
        "oldValue": 2
      }
    ]
  },
  {
    "name": "em-unique-rotation",
    "comment": "GEN §8.6: a multiset-equal unique reorder collapses to moves (5 replaces -> moves)",
    "schema": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "emitMoves": true
      }
    },
    "original": {
      "tags": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "modified": {
      "tags": [
        2,
        3,
        4,
        5,
        1
      ]
    },
    "expectedPatch": [
      {
        "op": "move",
        "from": "/tags/0",
        "path": "/tags/4"
      }
    ]
  },
  {
    "name": "em-unique-non-multiset-keeps-replaces",
    "comment": "GEN §8.6: a non-permutation unique diff keeps GEN §6 positional replaces",
    "schema": {
