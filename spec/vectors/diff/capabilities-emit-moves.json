  {
    "name": "em-primaryKey-full-mixed",
    "comment": "GEN §8.7: reorder + modify + add + remove together reconstruct modified exactly",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "options": {
      "capabilities": {
        "emitMoves": true
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "b",
          "name": "B"
        },
        {
          "id": "c",
          "name": "C"
        },
        {
          "id": "d",
          "name": "D"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "c",
          "name": "C2"
        },
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "e",
          "name": "E"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "remove",
        "path": "/users/3",
        "oldValue": {
          "id": "d",
          "name": "D"
        }
      },
      {
        "op": "remove",
        "path": "/users/1",
        "oldValue": {
          "id": "b",
          "name": "B"
        }
      },
      {
        "op": "move",
        "from": "/users/0",
        "path": "/users/1"
      },
      {
        "op": "add",
        "path": "/users/2",
        "value": {
          "id": "e",
          "name": "E"
        }
      },
      {
        "op": "replace",
        "path": "/users/0/name",
        "value": "C2",
        "oldValue": "C"
      }
    ]
  },
