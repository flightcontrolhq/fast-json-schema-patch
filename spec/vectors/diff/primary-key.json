[
  {
    "name": "pk-modify-one-field",
    "comment": "GEN §4.1: matched item changed -> field-level replace at the ORIGINAL index",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "b",
          "name": "B"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "a",
          "name": "A2"
        },
        {
          "id": "b",
          "name": "B"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/users/0/name",
        "value": "A2",
        "oldValue": "A"
      }
    ]
  },
  {
    "name": "pk-add-new-key",
