            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "original": {
      "users": [
        {
          "id": "x",
          "name": "A"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "y",
          "name": "A"
        }
      ]
    },
    "expectedPatch": [
