  {
    "name": "pk-worked-example",
    "comment": "GEN §4.2: the normative worked example — modifications(orig idx) ++ removals(desc) ++ /- appends",
    "schema": {
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "original": {
      "users": [
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "b",
          "name": "B"
        },
        {
          "id": "c",
          "name": "C"
        }
      ]
    },
    "modified": {
      "users": [
        {
          "id": "c",
          "name": "C2"
        },
        {
          "id": "a",
          "name": "A"
        },
        {
          "id": "d",
          "name": "D"
        },
        {
          "id": "e",
          "name": "E"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/users/2/name",
        "value": "C2",
        "oldValue": "C"
      },
      {
        "op": "remove",
        "path": "/users/1",
        "oldValue": {
          "id": "b",
          "name": "B"
        }
      },
      {
        "op": "add",
        "path": "/users/-",
        "value": {
          "id": "d",
          "name": "D"
        }
      },
      {
        "op": "add",
        "path": "/users/-",
        "value": {
          "id": "e",
          "name": "E"
        }
      }
    ]
  },
