  {
    "name": "pk-nested-keyed-arrays",
    "comment": "CORE §7.2.4: keyed arrays inside keyed arrays inherit the per-level contract",
    "schema": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "original": {
      "groups": [
        {
          "id": "g1",
          "members": [
            {
              "id": "m1",
              "role": "r1"
            },
            {
              "id": "m2",
              "role": "r2"
            }
          ]
        }
      ]
    },
    "modified": {
      "groups": [
        {
          "id": "g1",
          "members": [
            {
              "id": "m1",
              "role": "R1"
            },
            {
              "id": "m2",
              "role": "r2"
            }
          ]
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/groups/0/members/0/role",
        "value": "R1",
        "oldValue": "r1"
      }
    ]
  },
  {
    "name": "pk-via-primaryKeyMap-override",
    "comment": "CORE §3.4.3: primaryKeyMap selects primaryKey strategy without a schema-declared key",
    "schema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "v": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "options": {
      "primaryKeyMap": {
        "/items": "id"
      }
    },
    "original": {
      "items": [
        {
          "id": "a",
          "v": 1
        },
        {
          "id": "b",
          "v": 2
        }
      ]
    },
    "modified": {
      "items": [
        {
          "id": "a",
          "v": 9
        },
        {
          "id": "b",
          "v": 2
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/items/0/v",
        "value": 9,
        "oldValue": 1
      }
    ]
  }
