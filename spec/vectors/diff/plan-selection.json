  {
    "name": "sel-allOf-merged-primary-key",
    "comment": "CORE §3.5.1.1: a primaryKey declared only in an allOf branch is detected",
    "schema": {
      "type": "object",
      "properties": {
        "list": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "original": {
      "list": [
        {
          "id": "a",
          "name": "A"
        }
      ]
    },
    "modified": {
      "list": [
        {
          "id": "a",
          "name": "A2"
        }
      ]
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/list/0/name",
        "value": "A2",
        "oldValue": "A"
      }
    ]
  },
