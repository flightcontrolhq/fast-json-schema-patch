[
  {
    "name": "sel-additionalProperties-at-depth",
    "comment": "GEN §4.5.3: a /envs/* wildcard plan matches a concrete /envs/prod keyed array",
    "schema": {
      "type": "object",
      "properties": {
        "envs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "v": {
                  "type": "number"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        }
      }
    },
    "original": {
      "envs": {
        "prod": [
          {
            "id": "a",
            "v": 1
          }
        ]
      }
    },
    "modified": {
      "envs": {
        "prod": [
          {
            "id": "a",
            "v": 2
          }
        ]
      }
    },
    "expectedPatch": [
      {
        "op": "replace",
        "path": "/envs/prod/0/v",
        "value": 2,
        "oldValue": 1
      }
    ]
  },
  {
