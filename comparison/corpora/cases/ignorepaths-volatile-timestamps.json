{
  "name": "ignorepaths-volatile-timestamps",
  "category": "ignore-paths",
  "description": "A doc whose every record has churned volatile timestamps plus a handful of real status flips; ignorePaths skips the timestamps so ours emits only the real changes while a generic differ emits ~40x the noise",
  "schema": {
    "type": "object",
    "properties": {
      "meta": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string"
