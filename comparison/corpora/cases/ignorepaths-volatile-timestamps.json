          "version": {
            "type": "number"
          }
        }
      },
      "records": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            },
            "lastSeenAt": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "options": {
    "ignorePaths": [
      "/meta/generatedAt",
      "/records/*/updatedAt",
      "/records/*/lastSeenAt"
    ]
  },
  "roundtrip": "exact",
  "measureMemory": false,
  "tags": [
    "ignore-paths",
    "volatile",
    "timestamps"
  ],
